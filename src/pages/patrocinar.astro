---
import BaseLayout from "../layouts/BaseLayout.astro";
import { useTranslations } from "../i18n/utils";
import { SHOW_SOCIALS } from "../data/social";
import SponsorsSection from "../components/SponsorsSection.astro";

const lang = "es" as const;
const t = useTranslations(lang);
---

<BaseLayout
	title={`Patrocinar | ${t.meta.title}`}
	description="Patrocina Las Locuras de Miguelín y llega a millones de personas"
	lang={lang}
>
	<!-- Hero -->
	<section
		class="relative flex min-h-[60vh] items-center overflow-hidden pt-24"
	>
		<div class="pointer-events-none absolute inset-0 overflow-hidden">
			<div
				class="animate-float absolute left-10 top-20 h-96 w-96 rounded-full bg-accent/10 blur-3xl"
			>
			</div>
			<div
				class="animate-float absolute bottom-20 right-10 h-72 w-72 rounded-full bg-primary/10 blur-3xl"
				style="animation-delay: 1.5s;"
			>
			</div>
			<div
				class="animate-float absolute left-1/3 top-1/2 h-64 w-64 rounded-full bg-neon-purple/10 blur-3xl"
				style="animation-delay: 2.5s;"
			>
			</div>
		</div>
		<div
			class="relative z-10 mx-auto max-w-5xl px-4 py-16 text-center sm:px-6 lg:px-8"
		>
			<div
				class="mb-6 inline-block animate-pulse rounded-full border border-accent/30 bg-accent/20 px-4 py-1 text-sm font-bold text-accent"
			>
				🤝 PARTNERS & SPONSORS
			</div>
			<h1
				class="mb-6 font-display text-5xl leading-[0.9] text-white md:text-7xl lg:text-8xl"
			>
				{t.sponsorPage.heroTitle}
			</h1>
			<p class="mx-auto max-w-2xl text-xl text-white/50">
				{t.sponsorPage.heroSubtitle}
			</p>

			<!-- Stats Row -->
			<div class="mt-12 flex flex-wrap justify-center gap-6">
				<div
					class="rounded-2xl border border-white/10 bg-white/5 px-8 py-5 text-center"
				>
					<div class="mb-1 flex items-center justify-center gap-2">
						<svg
							class="h-5 w-5 text-red-500"
							fill="currentColor"
							viewBox="0 0 24 24"
							><path
								d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
							></path></svg
						>
						<span class="text-xs font-bold uppercase text-white/40"
							>YouTube</span
						>
					</div>
					<span class="font-display text-3xl text-white"
						>{SHOW_SOCIALS.stats.youtube}</span
					>
				</div>
				<div
					class="rounded-2xl border border-white/10 bg-white/5 px-8 py-5 text-center"
				>
					<div class="mb-1 flex items-center justify-center gap-2">
						<svg
							class="h-5 w-5 text-pink-500"
							fill="currentColor"
							viewBox="0 0 24 24"
							><path
								d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"
							></path></svg
						>
						<span class="text-xs font-bold uppercase text-white/40"
							>Instagram</span
						>
					</div>
					<span class="font-display text-3xl text-white"
						>{SHOW_SOCIALS.stats.instagram}</span
					>
				</div>
				<div
					class="rounded-2xl border border-white/10 bg-white/5 px-8 py-5 text-center"
				>
					<div class="mb-1 flex items-center justify-center gap-2">
						<svg
							class="h-5 w-5 text-blue-500"
							fill="currentColor"
							viewBox="0 0 24 24"
							><path
								d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
							></path></svg
						>
						<span class="text-xs font-bold uppercase text-white/40"
							>Facebook</span
						>
					</div>
					<span class="font-display text-3xl text-white"
						>{SHOW_SOCIALS.stats.facebook}</span
					>
				</div>
			</div>
		</div>
	</section>

	<!-- Why Us Stories -->
	<section class="py-20">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<h2
				class="mb-16 text-center font-display text-4xl text-white md:text-5xl"
			>
				{t.sponsorPage.storyTitle}
			</h2>
			<div class="grid gap-8 md:grid-cols-3">
				<div
					class="group rounded-2xl border border-white/5 bg-secondary p-8 transition-all duration-300 hover:-translate-y-2 hover:border-primary/30"
				>
					<div
						class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-primary/20 transition group-hover:bg-primary/40"
					>
						<span class="text-3xl">🎙</span>
					</div>
					<p class="text-lg leading-relaxed text-white/70">
						{t.sponsorPage.story1}
					</p>
				</div>
				<div
					class="group rounded-2xl border border-white/5 bg-secondary p-8 transition-all duration-300 hover:-translate-y-2 hover:border-accent/30"
				>
					<div
						class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-accent/20 transition group-hover:bg-accent/40"
					>
						<span class="text-3xl">🔥</span>
					</div>
					<p class="text-lg leading-relaxed text-white/70">
						{t.sponsorPage.story2}
					</p>
				</div>
				<div
					class="group rounded-2xl border border-white/5 bg-secondary p-8 transition-all duration-300 hover:-translate-y-2 hover:border-neon-purple/30"
				>
					<div
						class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-neon-purple/20 transition group-hover:bg-neon-purple/40"
					>
						<span class="text-3xl">📈</span>
					</div>
					<p class="text-lg leading-relaxed text-white/70">
						{t.sponsorPage.story3}
					</p>
				</div>
			</div>
		</div>
	</section>

	<SponsorsSection lang={lang} showScamWarning={false} />

	<!-- Plans -->
	<section class="bg-secondary/30 py-20">
		<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
			<div class="mb-16 text-center">
				<span class="text-sm font-medium uppercase tracking-widest text-accent"
					>Plans</span
				>
				<h2 class="mt-2 font-display text-4xl text-white md:text-5xl">
					{t.sponsorPage.plansTitle}
				</h2>
			</div>
			<div class="grid gap-8 md:grid-cols-3">
				<!-- Plan 1: Basic -->
				<div
					class="flex flex-col rounded-3xl border border-white/10 bg-secondary p-8 transition-all duration-300 hover:-translate-y-2 hover:border-white/20"
				>
					<div class="mb-8 text-center">
						<div
							class="mb-4 inline-block rounded-full bg-white/5 px-4 py-1 text-xs font-bold uppercase tracking-widest text-white/50"
						>
							Starter
						</div>
						<h3 class="font-display text-2xl text-white">
							{t.sponsorPage.plan1}
						</h3>
					</div>
					<ul class="flex-1 space-y-4 text-sm text-white/50">
						<li class="flex items-start gap-3">
							<span class="mt-0.5 text-primary">✓</span> Mención durante el episodio
						</li>
						<li class="flex items-start gap-3">
							<span class="mt-0.5 text-primary">✓</span> Logo en la descripción del
							video
						</li>
						<li class="flex items-start gap-3">
							<span class="mt-0.5 text-primary">✓</span> Etiqueta en redes sociales
						</li>
					</ul>
				</div>
				<!-- Plan 2: Viral -->
				<div
					class="relative flex flex-col rounded-3xl border-2 border-primary/40 bg-gradient-to-b from-primary/10 to-secondary p-8 transition-all duration-300 hover:-translate-y-3 hover:border-primary"
				>
					<div
						class="absolute -top-4 left-1/2 -translate-x-1/2 rounded-full bg-primary px-4 py-1.5 text-xs font-bold text-white shadow-lg shadow-primary/40"
					>
						🔥 POPULAR
					</div>
					<div class="mb-8 text-center">
						<div
							class="mb-4 inline-block rounded-full bg-primary/20 px-4 py-1 text-xs font-bold uppercase tracking-widest text-primary"
						>
							Pro
						</div>
						<h3 class="font-display text-2xl text-white">
							{t.sponsorPage.plan2}
						</h3>
					</div>
					<ul class="flex-1 space-y-4 text-sm text-white/60">
						<li class="flex items-start gap-3">
							<span class="mt-0.5 text-primary">✓</span> Todo lo del plan Básico
						</li>
						<li class="flex items-start gap-3">
							<span class="mt-0.5 text-primary">✓</span> Segmento dedicado en el show
						</li>
						<li class="flex items-start gap-3">
							<span class="mt-0.5 text-primary">✓</span> Post en Instagram + Story
						</li>
						<li class="flex items-start gap-3">
							<span class="mt-0.5 text-primary">✓</span> Clip viral en TikTok/Reels
						</li>
					</ul>
				</div>
				<!-- Plan 3: Elite -->
				<div
					class="flex flex-col rounded-3xl border border-accent/20 bg-secondary p-8 transition-all duration-300 hover:-translate-y-2 hover:border-accent/50"
				>
					<div class="mb-8 text-center">
						<div
							class="mb-4 inline-block rounded-full bg-accent/20 px-4 py-1 text-xs font-bold uppercase tracking-widest text-accent"
						>
							VIP
						</div>
						<h3 class="font-display text-2xl text-white">
							{t.sponsorPage.plan3}
						</h3>
					</div>
					<ul class="flex-1 space-y-4 text-sm text-white/50">
						<li class="flex items-start gap-3">
							<span class="mt-0.5 text-accent">✓</span> Todo lo del plan Viral
						</li>
						<li class="flex items-start gap-3">
							<span class="mt-0.5 text-accent">✓</span> Patrocinio oficial del show
						</li>
						<li class="flex items-start gap-3">
							<span class="mt-0.5 text-accent">✓</span> Tu producto físicamente en
							el set
						</li>
						<li class="flex items-start gap-3">
							<span class="mt-0.5 text-accent">✓</span> Presencia en eventos en vivo
						</li>
						<li class="flex items-start gap-3">
							<span class="mt-0.5 text-accent">✓</span> Acceso al crew para colaboraciones
						</li>
					</ul>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>
