---
import type { Locale } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const facebookReelsUrl = "https://www.facebook.com/locurasdemiguelin/reels/";
const facebookPageUrl = "https://www.facebook.com/locurasdemiguelin";
const pagePluginSrc = `https://www.facebook.com/plugins/page.php?href=${encodeURIComponent(facebookPageUrl)}&tabs=timeline&width=500&height=700&small_header=true&adapt_container_width=true&hide_cover=false&show_facepile=false`;
---

<section id="momentos" class="bg-secondary/50 py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mb-12 text-center">
			<span
				class="text-sm font-medium uppercase tracking-widest text-neon-yellow"
				>{t.sections.viralMomentsLabel}</span
			>
			<h2 class="section-title mt-2 text-white">{t.sections.viralMoments}</h2>
		</div>

		<div class="mx-auto max-w-4xl">
			<!-- Facebook Page Plugin Embed -->
			<div class="mb-10 flex justify-center">
				<div
					class="overflow-hidden rounded-2xl border border-white/10 bg-white"
				>
					<iframe
						src={pagePluginSrc}
						width="500"
						height="700"
						style="border:none;overflow:hidden"
						allowfullscreen={true}
						allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
						loading="lazy"></iframe>
				</div>
			</div>

			<!-- CTA to Facebook Reels -->
			<div class="text-center">
				<p class="mb-6 text-lg text-white/60">
					{
						lang === "es"
							? "Mira todos los momentos virales de Las Locuras de Miguelín"
							: "Watch all the viral moments from Las Locuras de Miguelín"
					}
				</p>
				<a
					href={facebookReelsUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="neon-glow inline-flex items-center gap-3 rounded-xl bg-blue-600 px-8 py-4 text-lg font-semibold text-white transition hover:bg-blue-700"
				>
					<svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24"
						><path
							d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
						></path></svg
					>
					{lang === "es" ? "Ver Reels en Facebook" : "Watch Reels on Facebook"}
					<span class="text-xl">→</span>
				</a>
			</div>
		</div>
	</div>
</section>
