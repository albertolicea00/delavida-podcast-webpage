---
import type { Locale } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";
import { getSiteData } from "../data/site";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const data = getSiteData(lang);
const event = data.nextEvent;
---

<section id="eventos" class="py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mb-12 text-center">
			<span
				class="text-sm font-medium uppercase tracking-widest text-neon-yellow"
				>{t.sections.eventLabel}</span
			>
			<h2 class="section-title mt-2 text-white">{t.sections.event}</h2>
		</div>
		<div
			class="event-card mx-auto max-w-2xl p-8 text-center opacity-60 md:p-12"
		>
			<div
				class="mb-4 inline-block rounded-full bg-white/10 px-4 py-1 text-sm font-medium text-white/50"
			>
				{lang === "es" ? "Proximamente" : "Coming Soon"}
			</div>
			<h3 class="mb-3 font-display text-4xl text-white/50 md:text-5xl">
				{event.title}
			</h3>
			<p class="mb-2 text-lg text-white/30">{event.venue}</p>
			<p class="mb-2 text-white/20">{event.city}</p>
			<p class="mx-auto mb-8 max-w-md text-white/30">{event.description}</p>
			<button
				disabled
				class="inline-block cursor-not-allowed rounded-xl border border-white/10 bg-white/10 px-8 py-4 text-lg font-semibold text-white/30"
			>
				{lang === "es" ? "Proximamente" : "Coming Soon"}
			</button>
		</div>
	</div>
</section>
