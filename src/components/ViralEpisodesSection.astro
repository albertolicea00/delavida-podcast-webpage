---
import type { Locale } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";
import { getSiteData } from "../data/site";
import type { YouTubeVideo } from "../services/youtube";

interface Props {
	lang: Locale;
	liveVideos?: YouTubeVideo[];
}

const { lang, liveVideos = [] } = Astro.props;
const t = useTranslations(lang);
const data = getSiteData(lang);
const hasLive = liveVideos.length > 0;
---

<section id="episodios" class="bg-secondary/50 py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mb-12 text-center">
			<span class="text-sm font-medium uppercase tracking-widest text-accent"
				>{t.sections.viralEpisodesLabel}</span
			>
			<h2 class="section-title mt-2 text-white">{t.sections.viralEpisodes}</h2>
		</div>
		<div
			id="viral-episodes-grid"
			class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3"
		>
			{
				hasLive
					? liveVideos.map((video) => (
							<a
								href={`https://www.youtube.com/watch?v=${video.id}`}
								target="_blank"
								rel="noopener noreferrer"
								class="card-episode group block cursor-pointer"
							>
								<div class="relative overflow-hidden">
									<img
										src={video.thumbnail}
										alt={video.title}
										class="aspect-video w-full object-cover transition duration-500 group-hover:scale-110"
										loading="lazy"
									/>
									<div class="absolute left-3 top-3 flex flex-col items-start gap-1">
										<div class="rounded-lg bg-primary px-2 py-1 text-xs font-bold text-white">
											{video.viewCount} {t.characterPage.views}
										</div>
										{video.status === "upcoming" && (
											<div class="animate-pulse rounded-lg bg-blue-600 px-2 py-1 text-[10px] font-bold uppercase text-white">
												{t.characterPage.upcoming}
											</div>
										)}
										{video.status === "members-only" && (
											<div class="rounded-lg bg-amber-500 px-2 py-1 text-[10px] font-bold uppercase text-black">
												{t.characterPage.membersOnly}
											</div>
										)}
									</div>
									<div class="absolute bottom-3 right-3 rounded-lg bg-black/70 px-2 py-1 text-xs text-white backdrop-blur-sm">
										{video.duration}
									</div>
									<div class="absolute inset-0 flex items-center justify-center bg-black/0 transition group-hover:bg-black/30">
										<div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/80 opacity-0 transition group-hover:opacity-100">
											<svg
												class="ml-0.5 h-5 w-5 text-white"
												fill="currentColor"
												viewBox="0 0 24 24"
											>
												<path d="M8 5v14l11-7z" />
											</svg>
										</div>
									</div>
								</div>
								<div class="p-4">
									<h3 class="mt-1 line-clamp-2 font-semibold text-white">
										{video.title}
									</h3>
									<p class="mt-1 text-sm text-white/40">
										👁 {video.viewCount} · ❤️ {video.likeCount}
									</p>
								</div>
							</a>
						))
					: data.viralEpisodes.map((ep) => (
							<div class="card-episode group cursor-pointer">
								<div class="relative overflow-hidden">
									<img
										src={ep.thumbnail}
										alt={ep.title}
										class="aspect-video w-full object-cover transition duration-500 group-hover:scale-110"
									/>
									<div class="absolute left-3 top-3 rounded-lg bg-primary px-2 py-1 text-xs font-bold text-white">
										{ep.views} {t.characterPage.views}
									</div>
									<div class="absolute inset-0 flex items-center justify-center bg-black/0 transition group-hover:bg-black/30">
										<div class="flex h-12 w-12 items-center justify-center rounded-full bg-primary/80 opacity-0 transition group-hover:opacity-100">
											<svg
												class="ml-0.5 h-5 w-5 text-white"
												fill="currentColor"
												viewBox="0 0 24 24"
											>
												<path d="M8 5v14l11-7z" />
											</svg>
										</div>
									</div>
								</div>
								<div class="p-4">
									<p class="text-xs text-white/50">EP {ep.number}</p>
									<h3 class="mt-1 font-semibold text-white">{ep.title}</h3>
									<p class="mt-1 text-sm text-white/40">🎤 {ep.guest}</p>
								</div>
							</div>
						))
			}
		</div>
	</div>
</section>
