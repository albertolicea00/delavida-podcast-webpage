---
import type { Locale } from "../i18n/utils";
import { useTranslations, getLocalizedPath } from "../i18n/utils";
import { getSiteData } from "../data/site";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const data = getSiteData(lang);
---

<!-- Hero -->
<section class="relative overflow-hidden pb-16 pt-32">
	<div class="pointer-events-none absolute inset-0 overflow-hidden">
		<div
			class="animate-float absolute right-10 top-20 h-96 w-96 rounded-full bg-primary/10 blur-3xl"
		>
		</div>
		<div
			class="animate-float absolute bottom-0 left-10 h-72 w-72 rounded-full bg-neon-purple/10 blur-3xl"
			style="animation-delay: 1s;"
		>
		</div>
	</div>
	<div class="relative z-10 mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
		<span class="text-sm font-medium uppercase tracking-widest text-primary"
			>{t.sections.crewLabel}</span
		>
		<h1 class="mt-4 font-display text-6xl text-white md:text-8xl">
			{t.crewPage.title}
		</h1>
		<p class="mx-auto mt-4 max-w-2xl text-lg text-white/50">
			{t.crewPage.subtitle}
		</p>
	</div>
</section>

<!-- Quiz CTA -->
<section class="pb-12">
	<div class="mx-auto max-w-7xl px-4 text-center sm:px-6 lg:px-8">
		<div
			class="inline-block rounded-2xl border border-primary/30 bg-gradient-to-r from-primary/20 to-neon-purple/20 px-8 py-4"
		>
			<p class="font-display text-xl text-white">{t.crewPage.quizTitle}</p>
			<p class="mt-1 text-sm text-white/50">{t.crewPage.quizSubtitle}</p>
			<button
				id="quiz-start-btn"
				class="mt-3 rounded-xl bg-primary px-6 py-2 text-sm font-semibold text-white transition hover:bg-primary/80"
			>
				{t.actions.takeQuiz}
			</button>
		</div>
	</div>
</section>

<!-- Quiz Modal -->
<div
	id="quiz-modal"
	class="fixed inset-0 z-50 flex hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm"
>
	<div
		class="relative w-full max-w-lg rounded-2xl border border-white/10 bg-secondary p-8"
	>
		<button
			id="quiz-close-btn"
			class="absolute right-4 top-4 text-white/50 hover:text-white"
		>
			<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
				><path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M6 18L18 6M6 6l12 12"></path></svg
			>
		</button>
		<div id="quiz-question-container"></div>
		<div id="quiz-result-container" class="hidden text-center"></div>
	</div>
</div>

<!-- Crew Grid -->
<section class="py-12">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid grid-cols-2 gap-8 lg:grid-cols-3">
			{
				data.characters.map((character) => (
					<a
						href={getLocalizedPath(`/personajes/${character.id}`, lang)}
						class="card-crew group relative block"
					>
						<div class="relative aspect-[3/4] overflow-hidden bg-gradient-to-br from-white/5 to-white/0">
							<img
								src={character.photo}
								alt={character.name}
								class="absolute inset-0 h-full w-full object-cover"
								loading="lazy"
								onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
							/>
							<div class="absolute inset-0 hidden items-center justify-center">
								<span class="text-8xl">🎭</span>
							</div>
							<div class="absolute inset-0 bg-gradient-to-t from-secondary via-secondary/50 to-transparent" />
							<div class="absolute right-4 top-4 rounded-full bg-black/60 px-3 py-1 text-xs font-medium text-white/80 backdrop-blur-sm">
								{character.episodeCount}{" "}
								{t.characterPage.episodes.toLowerCase()}
							</div>
							<div
								class="absolute left-4 top-4 rounded-full px-3 py-1 text-xs font-bold text-white"
								style={`background:${character.color}`}
							>
								{character.role}
							</div>
						</div>
						<div class="relative z-10 -mt-16 p-6">
							<h3 class="font-display text-3xl text-white transition group-hover:text-primary">
								{character.name}
							</h3>
							<p class="mt-2 text-sm italic leading-relaxed text-white/40">
								{character.quote}
							</p>
							<p class="mt-3 line-clamp-2 text-sm text-white/30">
								{character.bio}
							</p>
							<div class="mt-5 flex items-center gap-2 text-sm font-medium text-primary">
								<span>{t.actions.viewFullProfile}</span>
								<svg
									class="h-4 w-4 transition group-hover:translate-x-1"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M9 5l7 7-7 7"
									/>
								</svg>
							</div>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>

<script
	define:vars={{
		questions: t.quiz.questions,
		characters: data.characters.map((c) => ({
			id: c.id,
			name: c.name,
			role: c.role,
			quote: c.quote,
		})),
		resultIntro: t.crewPage.quizResultIntro,
		resultPrefix: t.crewPage.quizResultPrefix,
		resultSuffix: t.crewPage.quizResultSuffix,
		tryAgainText: t.actions.tryAgain,
		viewProfileText: t.actions.viewProfile,
		questionLabel: "question",
		ofLabel: "of",
		basePath: lang === "es" ? "/personajes/" : "/en/personajes/",
	}}
	is:inline
>
	const modal = document.getElementById("quiz-modal");
	const questionContainer = document.getElementById("quiz-question-container");
	const resultContainer = document.getElementById("quiz-result-container");
	let step = 0;
	let scores = {};

	function renderQuestion() {
		const q = questions[step];
		questionContainer.innerHTML = `
      <p class="text-primary text-sm font-medium">${questionLabel} ${step + 1} ${ofLabel} ${questions.length}</p>
      <h3 class="text-white font-display text-2xl mt-2">${q.q}</h3>
      <div class="mt-6 space-y-3">
        ${q.opts
					.map(
						(opt) => `
          <button data-character="${opt.character}" class="quiz-opt w-full text-left bg-white/5 hover:bg-primary/20 border border-white/10 hover:border-primary rounded-xl px-5 py-3 text-white transition">
            ${opt.text}
          </button>
        `
					)
					.join("")}
      </div>
    `;
		questionContainer.querySelectorAll(".quiz-opt").forEach((btn) => {
			btn.addEventListener("click", () => {
				const char = btn.getAttribute("data-character");
				scores[char] = (scores[char] || 0) + 1;
				if (step < questions.length - 1) {
					step++;
					renderQuestion();
				} else {
					showResult();
				}
			});
		});
	}

	function showResult() {
		const winner = Object.entries(scores).sort((a, b) => b[1] - a[1])[0][0];
		const character = character.find((c) => c.id === winner);
		questionContainer.classList.add("hidden");
		resultContainer.classList.remove("hidden");
		resultContainer.innerHTML = `
      <div class="text-6xl mb-4">🎭</div>
      <p class="text-white/50 text-sm">${resultIntro}</p>
      <h3 class="text-white font-display text-4xl mt-2">${resultPrefix} ${character.name.toUpperCase()}${resultSuffix}</h3>
      <p class="text-primary font-medium mt-2">${character.role}</p>
      <p class="text-white/50 mt-3 italic">${character.quote}</p>
      <div class="mt-6 flex gap-3 justify-center">
        <button id="quiz-retry" class="bg-white/10 hover:bg-white/20 text-white px-5 py-2 rounded-xl transition text-sm">${tryAgainText}</button>
        <a href="${basePath}${character.id}" class="bg-primary hover:bg-primary/80 text-white px-5 py-2 rounded-xl transition text-sm">${viewProfileText}</a>
      </div>
    `;
		document.getElementById("quiz-retry")?.addEventListener("click", resetQuiz);
	}

	function resetQuiz() {
		step = 0;
		scores = {};
		questionContainer.classList.remove("hidden");
		resultContainer.classList.add("hidden");
		renderQuestion();
	}

	document.getElementById("quiz-start-btn")?.addEventListener("click", () => {
		resetQuiz();
		modal?.classList.remove("hidden");
	});
	document.getElementById("quiz-close-btn")?.addEventListener("click", () => {
		modal?.classList.add("hidden");
	});
</script>
