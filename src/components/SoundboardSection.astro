---
import type { Locale } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";
import { getSiteData } from "../data/site";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const data = getSiteData(lang);
---

<section id="soundboard" class="py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mb-12 text-center">
			<span class="text-sm font-medium uppercase tracking-widest text-primary"
				>{t.sections.soundboardLabel}</span
			>
			<h2 class="section-title mt-2 text-white">{t.sections.soundboard}</h2>
			<p class="mt-3 text-white/50">{t.sections.soundboardSubtitle}</p>
		</div>
		<div class="mx-auto grid max-w-3xl grid-cols-2 gap-4 sm:grid-cols-4">
			{
				data.soundboard.map((sound) => (
					<button class="sound-btn text-center" data-sound-text={sound.text}>
						<span class="mb-1 block text-2xl">{sound.emoji}</span>
						<span>{sound.text}</span>
					</button>
				))
			}
		</div>

		<!-- Meme Generator -->
		<div class="mx-auto mt-12 max-w-md text-center">
			<button
				id="locura-btn"
				class="neon-glow transform rounded-2xl bg-gradient-to-r from-primary to-neon-purple px-8 py-5 font-display text-2xl text-white transition hover:scale-105 hover:from-primary/80 hover:to-neon-purple/80"
			>
				{t.actions.generateLocura}
			</button>
			<div
				id="locura-result"
				class="mt-6 hidden rounded-2xl border border-primary/30 bg-secondary p-6"
			>
				<p id="locura-text" class="font-display text-xl text-white"></p>
			</div>
		</div>
	</div>
</section>

<script define:vars={{ locuras: t.locuras }} is:inline>
	// Soundboard
	document.querySelectorAll("[data-sound-text]").forEach((btn) => {
		btn.addEventListener("click", () => {
			const text = btn.getAttribute("data-sound-text");
			btn.classList.add("bg-primary", "scale-95");
			setTimeout(() => btn.classList.remove("bg-primary", "scale-95"), 300);
			if ("speechSynthesis" in window) {
				const utterance = new SpeechSynthesisUtterance(text);
				utterance.lang = "es-ES";
				utterance.rate = 1.2;
				utterance.pitch = 1.1;
				speechSynthesis.speak(utterance);
			}
		});
	});

	// Meme Generator
	const locuraBtn = document.getElementById("locura-btn");
	const locuraResult = document.getElementById("locura-result");
	const locuraText = document.getElementById("locura-text");

	locuraBtn?.addEventListener("click", () => {
		const random = Math.floor(Math.random() * locuras.length);
		if (locuraText) locuraText.textContent = locuras[random];
		locuraResult?.classList.remove("hidden");
	});
</script>
