---
import type { Locale } from "../i18n/utils";
import { useTranslations, getLocalizedPath } from "../i18n/utils";
import { getSiteData } from "../data/site";

interface Props {
	lang: Locale;
	profilePics?: Record<string, string>;
}

const { lang, profilePics = {} } = Astro.props;
const t = useTranslations(lang);
const data = getSiteData(lang);
---

<section id="crew" class="py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mb-12 text-center">
			<span
				class="text-sm font-medium uppercase tracking-widest text-neon-purple"
				>{t.sections.crewLabel}</span
			>
			<h2 class="section-title mt-2 text-white">{t.sections.crew}</h2>
			<p class="mx-auto mt-3 max-w-xl text-white/50">
				{t.sections.crewSubtitle}
			</p>
		</div>
		<div class="grid grid-cols-2 gap-6 lg:grid-cols-3">
			{
				data.characters.map((character) => {
					const pic = profilePics[character.id] || character.photo;
					return (
						<a
							href={getLocalizedPath(`/personajes/${character.id}`, lang)}
							class="card-crew group block"
						>
							<div class="relative aspect-square overflow-hidden bg-gradient-to-br from-white/5 to-white/0">
								<img
									src={pic}
									alt={character.name}
									class="absolute inset-0 h-full w-full object-cover"
									loading="lazy"
								/>
								<div class="absolute inset-0 bg-gradient-to-t from-secondary via-transparent to-transparent" />
								<div class="absolute right-3 top-3 rounded-lg bg-black/60 px-2 py-1 text-xs text-white/80 backdrop-blur-sm">
									{character.role}
								</div>
							</div>
							<div class="p-5">
								<h3 class="font-display text-xl text-white transition group-hover:text-primary">
									{character.name}
								</h3>
								<p class="mt-1 text-sm font-medium text-primary">
									{character.role}
								</p>
								<p class="mt-2 text-sm italic text-white/40">
									{character.quote}
								</p>
								<div class="mt-4 flex items-center gap-2 text-sm text-accent opacity-0 transition group-hover:opacity-100">
									<span>{t.actions.viewProfile}</span>
									<svg
										class="h-4 w-4"
										fill="none"
										stroke="currentColor"
										viewBox="0 0 24 24"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M9 5l7 7-7 7"
										/>
									</svg>
								</div>
							</div>
						</a>
					);
				})
			}
		</div>
		<div class="mt-10 text-center">
			<a
				href={getLocalizedPath("/personajes", lang)}
				class="inline-flex items-center gap-2 rounded-xl border border-white/20 px-6 py-3 font-medium text-white transition hover:border-primary hover:text-primary"
			>
				{t.sections.viewAllCrew}
				<svg
					class="h-4 w-4"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					><path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M9 5l7 7-7 7"></path></svg
				>
			</a>
		</div>
	</div>
</section>
