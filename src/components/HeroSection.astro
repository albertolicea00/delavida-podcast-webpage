---
import type { Locale } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";
import { SHOW_SOCIALS } from "../data/social";
import type { YouTubeChannelInfo } from "../services/youtube";

interface Props {
	lang: Locale;
	channelInfo?: YouTubeChannelInfo | null;
}

const { lang, channelInfo } = Astro.props;
const t = useTranslations(lang);
const videoCount = channelInfo?.videoCount
	? parseInt(channelInfo.videoCount, 10)
	: 0;
const episodeBadge =
	videoCount > 0 ? `+${videoCount} VIDEOS` : t.hero.episodesCount;
---

<section
	class="hero-bg relative flex min-h-screen items-center overflow-hidden"
>
	<div class="pointer-events-none absolute inset-0 overflow-hidden">
		<div
			class="animate-float absolute left-10 top-20 h-72 w-72 rounded-full bg-primary/10 blur-3xl"
		>
		</div>
		<div
			class="animate-float absolute bottom-20 right-10 h-96 w-96 rounded-full bg-accent/10 blur-3xl"
			style="animation-delay: 1s;"
		>
		</div>
		<div
			class="animate-float absolute left-1/2 top-1/2 h-64 w-64 rounded-full bg-neon-purple/10 blur-3xl"
			style="animation-delay: 2s;"
		>
		</div>
	</div>

	<div class="relative z-10 mx-auto max-w-7xl px-4 pb-16 pt-24 sm:px-6 lg:px-8">
		<div class="grid items-center gap-12 lg:grid-cols-2">
			<div>
				<h1 class="hero-title mb-2 text-white">{t.hero.line1}</h1>
				<h1 class="hero-title mb-6 text-primary">{t.hero.line2}</h1>
				<p class="mb-8 max-w-lg text-lg text-white/60 md:text-xl">
					{t.hero.subtitle}
				</p>
				<div class="flex flex-wrap gap-4">
					<a
						href="#ultimo-episodio"
						class="neon-glow rounded-xl bg-primary px-8 py-4 text-lg font-semibold text-white transition hover:bg-primary/80"
					>
						{t.hero.watchLatest}
					</a>
					<div class="flex gap-2">
						<button
							disabled
							class="cursor-not-allowed rounded-xl border border-white/10 px-4 py-4 font-medium text-white/30"
						>
							{t.hero.subscribe}
						</button>
					</div>
				</div>
				<div class="mt-8 flex flex-wrap gap-3">
					<a
						href={SHOW_SOCIALS.youtube}
						target="_blank"
						rel="noopener noreferrer"
						class="group flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 transition hover:border-red-600 hover:bg-red-600"
					>
						<svg
							class="h-5 w-5 text-red-500 group-hover:text-white"
							fill="currentColor"
							viewBox="0 0 24 24"
							><path
								d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"
							></path></svg
						>
						<div class="flex flex-col">
							<span
								class="mb-0.5 text-[10px] font-bold uppercase leading-none text-white/40"
								>YouTube</span
							>
							<span class="text-sm font-bold leading-none text-white"
								>{SHOW_SOCIALS.stats.youtube}</span
							>
						</div>
					</a>
					<a
						href={SHOW_SOCIALS.instagram}
						target="_blank"
						rel="noopener noreferrer"
						class="group flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 transition hover:border-transparent hover:bg-gradient-to-tr hover:from-[#f09433] hover:via-[#dc2743] hover:to-[#bc1888]"
					>
						<svg
							class="h-5 w-5 text-pink-500 group-hover:text-white"
							fill="currentColor"
							viewBox="0 0 24 24"
							><path
								d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"
							></path></svg
						>
						<div class="flex flex-col">
							<span
								class="mb-0.5 text-[10px] font-bold uppercase leading-none text-white/40"
								>Instagram</span
							>
							<span class="text-sm font-bold leading-none text-white"
								>{SHOW_SOCIALS.stats.instagram}</span
							>
						</div>
					</a>
					<a
						href={SHOW_SOCIALS.facebook}
						target="_blank"
						rel="noopener noreferrer"
						class="group flex items-center gap-3 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 transition hover:border-blue-600 hover:bg-blue-600"
					>
						<svg
							class="h-5 w-5 text-blue-500 group-hover:text-white"
							fill="currentColor"
							viewBox="0 0 24 24"
							><path
								d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
							></path></svg
						>
						<div class="flex flex-col">
							<span
								class="mb-0.5 text-[10px] font-bold uppercase leading-none text-white/40"
								>Facebook</span
							>
							<span class="text-sm font-bold leading-none text-white"
								>{SHOW_SOCIALS.stats.facebook}</span
							>
						</div>
					</a>
				</div>
			</div>
			<div class="relative hidden lg:block">
				<!-- Glowing ring behind logo -->
				<div
					class="animate-float absolute inset-0 rounded-3xl bg-gradient-to-br from-primary/30 via-neon-purple/20 to-accent/30 blur-2xl"
				>
				</div>
				<div
					class="relative aspect-square w-full overflow-hidden rounded-3xl border-2 border-white/10 shadow-[0_0_60px_rgba(255,0,85,0.3)]"
				>
					<img
						src="/logo.webp"
						alt="Las Locuras de Miguelín"
						class="h-full w-full object-cover"
					/>
					<div
						class="absolute inset-0 bg-gradient-to-t from-dark/60 via-transparent to-transparent"
					>
					</div>
				</div>
				<div
					id="hero-video-count-badge"
					class="animate-float absolute -right-4 -top-4 rounded-xl bg-primary px-4 py-2 font-display text-lg text-white shadow-lg shadow-primary/40"
				>
					{episodeBadge}
				</div>
				<div
					class="animate-float absolute -bottom-4 -left-4 rounded-xl bg-accent px-4 py-2 font-display text-lg text-dark shadow-lg shadow-accent/40"
					style="animation-delay: 1.5s;"
				>
					MIAMI
				</div>
				<div
					class="animate-float absolute -right-6 top-1/2 rounded-lg bg-neon-purple px-3 py-1.5 font-display text-sm text-white shadow-lg shadow-neon-purple/40"
					style="animation-delay: 0.8s;"
				>
					EN VIVO
				</div>
			</div>
		</div>

		<!-- Scroll Indicator -->
		<div
			class="absolute bottom-10 left-1/2 flex -translate-x-1/2 flex-col items-center gap-1 opacity-50"
		>
			<svg
				class="animate-arrows-1 h-6 w-6 text-white"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
				><path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M19 9l-7 7-7-7"></path></svg
			>
			<svg
				class="animate-arrows-2 -mt-3 h-6 w-6 text-white"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
				><path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M19 9l-7 7-7-7"></path></svg
			>
			<svg
				class="animate-arrows-3 -mt-3 h-6 w-6 text-white"
				fill="none"
				stroke="currentColor"
				viewBox="0 0 24 24"
				><path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M19 9l-7 7-7-7"></path></svg
			>
		</div>
	</div>
</section>
