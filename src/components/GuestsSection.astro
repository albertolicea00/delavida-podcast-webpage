---
import type { Locale } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";
import { getSiteData } from "../data/site";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const data = getSiteData(lang);
---

<section class="bg-secondary/50 py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mb-12 text-center">
			<span class="text-sm font-medium uppercase tracking-widest text-accent"
				>{t.sections.guestsLabel}</span
			>
			<h2 class="section-title mt-2 text-white">{t.sections.guests}</h2>
		</div>
		<div class="grid grid-cols-2 gap-6 sm:grid-cols-4">
			{
				data.guests.map((guest) => (
					<div class="group cursor-pointer text-center">
						<div class="mx-auto h-32 w-32 overflow-hidden rounded-full border-2 border-white/10 transition duration-300 group-hover:rotate-2 group-hover:scale-110 group-hover:border-primary">
							<img
								src={guest.photo}
								alt={guest.name}
								class="h-full w-full object-cover"
							/>
						</div>
						<p class="mt-3 font-medium text-white">{guest.name}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
