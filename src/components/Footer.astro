---
import type { Locale } from "../i18n/utils";
import { useTranslations, getLocalizedPath } from "../i18n/utils";
import { SHOW_SOCIALS } from "../data/social";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homePath = getLocalizedPath("/", lang);
---

<footer class="footer-gradient border-t border-white/5 py-12">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="grid items-center gap-8 md:grid-cols-3">
			<div>
				<a href={homePath} class="flex items-center gap-2">
					<span class="font-display text-2xl text-primary">LAS LOCURAS</span>
					<span class="font-display text-2xl text-white">DE MIGUELÍN</span>
				</a>
				<p class="mt-2 text-sm text-white/40">{t.footer.tagline}</p>
			</div>
			<div class="text-center">
				<div class="flex justify-center gap-6 text-sm text-white/50">
					<a
						href={`${homePath}#episodios`}
						class="transition hover:text-primary">{t.nav.episodes}</a
					>
					<a
						href={getLocalizedPath("/personajes", lang)}
						class="transition hover:text-primary">{t.nav.crew}</a
					>
					<a href={`${homePath}#eventos`} class="transition hover:text-primary"
						>{t.nav.events}</a
					>
					<a href={`${homePath}#partners`} class="transition hover:text-primary"
						>{t.nav.merch}</a
					>
				</div>
			</div>
			<div class="text-right">
				<div class="flex justify-end gap-4">
					<a
						href={SHOW_SOCIALS.youtube}
						target="_blank"
						rel="noopener noreferrer"
						class="text-white/30 transition hover:text-primary">YouTube</a
					>
					<a
						href={SHOW_SOCIALS.instagram}
						target="_blank"
						rel="noopener noreferrer"
						class="text-white/30 transition hover:text-primary">Instagram</a
					>
					<a
						href={SHOW_SOCIALS.facebook}
						target="_blank"
						rel="noopener noreferrer"
						class="text-white/30 transition hover:text-primary">Facebook</a
					>
				</div>
				<p class="mt-2 text-xs text-white/20">
					&copy; 2026 Las Locuras de Miguelín
				</p>
			</div>
		</div>
	</div>
</footer>
