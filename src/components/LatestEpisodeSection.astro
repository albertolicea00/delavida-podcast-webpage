---
import type { Locale } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";
import { getSiteData } from "../data/site";
import type { YouTubeVideo } from "../services/youtube";

interface Props {
	lang: Locale;
	liveVideo?: YouTubeVideo | null;
}

const { lang, liveVideo } = Astro.props;
const t = useTranslations(lang);
const data = getSiteData(lang);
const fallback = data.latestEpisode;

// Use live YouTube data if available, otherwise fallback
const hasLive = !!liveVideo;
const title = hasLive
	? liveVideo!.title
	: `EP ${fallback.number} — ${fallback.title}`;
const thumbnail = hasLive ? liveVideo!.thumbnailHigh : fallback.thumbnail;
const duration = hasLive ? liveVideo!.duration : fallback.duration;
const views = hasLive ? liveVideo!.viewCount : "";
const videoUrl = hasLive
	? `https://www.youtube.com/watch?v=${liveVideo!.id}`
	: "#";
const embedUrl = hasLive ? liveVideo!.embedUrl : "";
---

<section id="ultimo-episodio" class="relative py-20">
	<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
		<div class="mb-12 text-center">
			<span class="text-sm font-medium uppercase tracking-widest text-primary"
				>{t.sections.latestEpisodeLabel}</span
			>
			<h2 class="section-title mt-2 text-white">{t.sections.latestEpisode}</h2>
		</div>
		<div class="mx-auto max-w-4xl">
			{
				hasLive ? (
					<div
						id="latest-episode-media"
						class="neon-border relative aspect-video overflow-hidden rounded-2xl bg-secondary"
					>
						<iframe
							src={`${embedUrl}?rel=0`}
							title={title}
							class="h-full w-full border-0"
							allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
							allowfullscreen
						/>
					</div>
				) : (
					<div
						id="latest-episode-media"
						class="neon-border relative aspect-video overflow-hidden rounded-2xl bg-secondary"
					>
						<img
							src={thumbnail}
							alt={title}
							class="h-full w-full object-cover"
						/>
						<div class="group absolute inset-0 flex cursor-pointer items-center justify-center bg-black/40 transition hover:bg-black/20">
							<div class="neon-glow flex h-20 w-20 items-center justify-center rounded-full bg-primary transition group-hover:scale-110">
								<svg
									class="ml-1 h-8 w-8 text-white"
									fill="currentColor"
									viewBox="0 0 24 24"
								>
									<path d="M8 5v14l11-7z" />
								</svg>
							</div>
						</div>
					</div>
				)
			}
			<div class="mt-6 flex flex-wrap items-center justify-between gap-4">
				<div>
					<div
						id="latest-episode-title-row"
						class="mb-2 flex items-center gap-2"
					>
						<h3 id="latest-episode-title" class="text-2xl font-bold text-white">
							{title}
						</h3>
						{
							hasLive && liveVideo!.status === "upcoming" && (
								<span
									data-status-badge="true"
									class="animate-pulse rounded-full bg-blue-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white"
								>
									{t.characterPage.upcoming}
								</span>
							)
						}
						{
							hasLive && liveVideo!.status === "members-only" && (
								<span
									data-status-badge="true"
									class="rounded-full bg-amber-500 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-black"
								>
									{t.characterPage.membersOnly}
								</span>
							)
						}
					</div>
					<div
						id="latest-episode-meta"
						class="mt-2 flex gap-4 text-sm text-white/50"
					>
						{duration && <span>⏱ {duration}</span>}
						{
							views && !(hasLive && liveVideo!.status === "upcoming") && (
								<span>
									👁 {views} {t.characterPage.views}
								</span>
							)
						}
						{!hasLive && <span>🎤 {fallback.guest}</span>}
						{!hasLive && <span>💬 {fallback.topic}</span>}
					</div>
				</div>
				<a
					id="latest-episode-link"
					href={videoUrl}
					target="_blank"
					rel="noopener noreferrer"
					class="rounded-xl border border-primary/30 bg-primary/20 px-6 py-3 font-medium text-primary transition hover:bg-primary hover:text-white"
				>
					{t.actions.watchOnYoutube}
				</a>
			</div>
		</div>
	</div>
</section>
