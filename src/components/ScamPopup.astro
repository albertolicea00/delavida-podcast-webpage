---
import type { Locale } from "../i18n/utils";
import { useTranslations } from "../i18n/utils";

interface Props {
	lang: Locale;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<!-- Scam Warning Popup (once per session) -->
<div
	id="scam-popup"
	class="fixed inset-0 z-[100] flex hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm"
>
	<div
		class="animate-float relative w-full max-w-md rounded-2xl border-2 border-red-500/50 bg-secondary p-8 shadow-2xl shadow-red-500/10"
		style="animation-duration: 3s;"
	>
		<!-- Close button -->
		<button
			id="scam-popup-close"
			class="absolute right-4 top-4 text-white/50 transition hover:text-white"
		>
			<svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"
				><path
					stroke-linecap="round"
					stroke-linejoin="round"
					stroke-width="2"
					d="M6 18L18 6M6 6l12 12"></path></svg
			>
		</button>

		<!-- Warning icon -->
		<div class="mb-6 text-center">
			<div
				class="mb-4 inline-flex h-16 w-16 items-center justify-center rounded-full border-2 border-red-500/40 bg-red-500/20"
			>
				<svg
					class="h-8 w-8 text-red-400"
					fill="none"
					stroke="currentColor"
					viewBox="0 0 24 24"
					><path
						stroke-linecap="round"
						stroke-linejoin="round"
						stroke-width="2"
						d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z"
					></path></svg
				>
			</div>
			<h3 class="font-display text-2xl text-red-400">{t.scamWarning.title}</h3>
		</div>

		<!-- Message -->
		<p class="mb-4 text-center leading-relaxed text-white/80">
			{t.scamWarning.message}
		</p>
		<p class="mb-2 text-center text-sm text-white/50">{t.scamWarning.tip}</p>
		<p class="mb-6 text-center text-xs text-white/30">{t.scamWarning.report}</p>

		<!-- Action -->
		<button
			id="scam-popup-ok"
			class="w-full rounded-xl bg-red-500 py-3 text-lg font-bold text-white transition hover:bg-red-600"
		>
			{lang === "es" ? "Entendido" : "Got it"}
		</button>
	</div>
</div>

<script>
	const popup = document.getElementById("scam-popup");
	const closeBtn = document.getElementById("scam-popup-close");
	const okBtn = document.getElementById("scam-popup-ok");

	function closePopup() {
		popup?.classList.add("hidden");
		sessionStorage.setItem("scam-warning-seen", "1");
	}

	// Show popup if not seen this session
	if (!sessionStorage.getItem("scam-warning-seen")) {
		// Small delay so the page loads first
		setTimeout(() => {
			popup?.classList.remove("hidden");
		}, 1500);
	}

	closeBtn?.addEventListener("click", closePopup);
	okBtn?.addEventListener("click", closePopup);

	// Close on backdrop click
	popup?.addEventListener("click", (e) => {
		if (e.target === popup) closePopup();
	});
</script>
